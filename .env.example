# ─────────────────────────────────────────────────────────────────────────────
# NBR Backend CRM — environment template
# Copy to .env and fill in. NEVER commit a real .env (DPDP §8 safeguards).
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
APP_NAME="NBR Backend CRM"
API_PORT=4100
WEB_PORT=5173
API_URL=http://localhost:4100
WEB_URL=http://localhost:5173
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=nbr
POSTGRES_PASSWORD=nbr_dev_password
POSTGRES_DB=nbr_crm
POSTGRES_PORT=5434
DATABASE_URL=postgresql://nbr:nbr_dev_password@localhost:5434/nbr_crm
DATABASE_POOL_MAX=20

# ── Redis (cache, sessions, rate limiting, BullMQ) ──────────────────────────
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
JWT_REFRESH_SECRET=CHANGE_ME_generate_a_DIFFERENT_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
SESSION_IDLE_TIMEOUT_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# ── Encryption at rest for sensitive identifiers (Aadhaar / passport / bank) ─
# 32-byte key, base64. Generate with: openssl rand -base64 32
# Rotating: move the old key into PII_ENCRYPTION_KEY_PREVIOUS so existing rows
# stay readable while the re-encryption job runs.
PII_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_base64_32
PII_ENCRYPTION_KEY_PREVIOUS=

# ── Platform Super Admin (seeded once; forced password change on first login) ─
SUPER_ADMIN_EMAIL=admin@nationalbookofrecords.in
SUPER_ADMIN_PASSWORD=CHANGE_ME_before_seeding
SUPER_ADMIN_NAME="Platform Super Admin"

# ── Object storage (Cloudflare R2 in production, MinIO locally) ─────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=nbr-vault
S3_ACCESS_KEY_ID=nbr_minio
S3_SECRET_ACCESS_KEY=nbr_minio_password
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=
UPLOAD_PRESIGN_TTL_SECONDS=900
DOWNLOAD_PRESIGN_TTL_SECONDS=300
MAX_UPLOAD_MB=200

# ── Email (SMTP) ────────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME="National Book of Records"
MAIL_FROM_ADDRESS=no-reply@nationalbookofrecords.in

# ── Inbound integration: existing NBR website admin panel ───────────────────
# Shared secret used to verify the HMAC-SHA256 signature on inbound webhooks.
NBR_WEBHOOK_SECRET=CHANGE_ME_shared_with_nbr_website
NBR_WEBHOOK_TOLERANCE_SECONDS=300
NBR_POLL_ENABLED=false
NBR_POLL_URL=
NBR_POLL_API_KEY=
NBR_POLL_INTERVAL_CRON=*/5 * * * *

# ── DPDP Act, 2023 compliance ───────────────────────────────────────────────
# Data Fiduciary + Grievance Officer details shown on the consent notice and
# in the data-principal rights workflow (DPDP §5, §13).
DPDP_DATA_FIDUCIARY_NAME="National Book of Records"
DPDP_GRIEVANCE_OFFICER_NAME="Grievance Officer"
DPDP_GRIEVANCE_OFFICER_EMAIL=grievance@nationalbookofrecords.in
DPDP_GRIEVANCE_OFFICER_PHONE=
# Statutory-ish service levels (days) for responding to data-principal requests
DPDP_DSR_RESPONSE_DAYS=30
DPDP_GRIEVANCE_RESPONSE_DAYS=30
# Retention: how long after a record reaches a terminal state personal data is
# kept before the erasure job anonymises it (DPDP §8(7)).
DPDP_RETENTION_YEARS=8
DPDP_BREACH_NOTIFY_HOURS=72
# Refuse to boot if the database host is outside the permitted region list.
DPDP_DATA_REGION=IN

# ── Observability ───────────────────────────────────────────────────────────
LOG_LEVEL=debug
SENTRY_DSN=
RATE_LIMIT_GLOBAL_PER_MINUTE=300
