{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": false,
    "assets": [
      {
        "//": "Drizzle needs the .sql files AND meta/_journal.json, which tsc does not emit.",
        "include": "database/migrations/**/*",
        "watchAssets": true
      }
    ]
  }
}
